# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# Backend selection: "memory" (default, no DB) or "postgres"
LEADCENTER_BACKEND=memory

# Required when LEADCENTER_BACKEND=postgres. Also used by the integration tests.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadcenter

# Credits granted to a new account on signup.
LEADCENTER_FREE_CREDITS=50

# Vendor keys (not used by the v1 spine; here so the contract is visible).
# OUTSCRAPER_API_KEY=
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
