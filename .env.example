# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# Backend selection: "memory" (default, no DB) or "postgres"
LEADCENTER_BACKEND=memory

# Required when LEADCENTER_BACKEND=postgres. Also used by the integration tests.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadcenter

# Credits granted to a new account on signup.
LEADCENTER_FREE_CREDITS=50

# Auth. "dev_header" trusts an X-Account-Id header (local/tests only).
# "session" requires a password login + signed cookie (production).
AUTH_MODE=dev_header
# Required when AUTH_MODE=session:
# SESSION_SECRET=               # long random string (e.g. `openssl rand -hex 32`)
# LOGIN_PASSWORD=               # tenant-#1 dashboard password
# TENANT_OWNER_USER_ID=tenant-1
# TENANT_NAME=FLUXO

# Outreach (step 5) — disabled by default (riskiest subsystem, behind a flag).
# When enabled, a real physical postal address is REQUIRED (CAN-SPAM); sending
# without it is refused.
OUTREACH_ENABLED=false
# OUTREACH_FROM_NAME=FLUXO
# OUTREACH_FROM_EMAIL=hi@yourdomain.com
# OUTREACH_PHYSICAL_ADDRESS=123 Main St, Your City, ST 00000
# OUTREACH_UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe

# Vendor keys (not used by the v1 spine; here so the contract is visible).
# OUTSCRAPER_API_KEY=
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
